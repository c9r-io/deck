{
  "schema": "deck-ce-plan/1",
  "id": "ce-full-local-1",
  "contract": "full-local-v1 parity baseline (CE1)",
  "governance": "deck-ce-governance-2026-09-27-r2 (approved)",
  "lanes": {
    "A1": "ci: deterministic Deck-Terminal baseline: login interactive zsh in a disposable bundled-tmux server with synthetic HOME, dotfiles and toolchain shims",
    "B-direct": "ci: deck-mcp-runner as the pane process of the same server; the probe is the executable (structured direct launch)",
    "B-login": "ci: same runner; executable /bin/zsh with -lc (the documented explicit-shell form)",
    "B-admission": "ci: the production deck_exec route (fake runner) admitting a Full Local cwd; mcp/tests.rs ce1_probe_*",
    "A2": "designated: the real Deck Terminal with the real user environment (needs maintainer approval; not run in CE1)",
    "B-designated": "designated: MCP Full Local in an isolated smoke Deck (needs maintainer approval; not run in CE1)"
  },
  "cases": [
    {"id": "FL-TOOL-env/direct", "track": "full_local_parity", "mandatory": true, "evidence_env": "ci", "compare": "tool", "lanes": ["A1", "B-direct"], "probe": ["tool", "ce-tool-env"], "note": "tool put on PATH by ~/.zshenv"},
    {"id": "FL-TOOL-env/login", "track": "full_local_parity", "mandatory": true, "evidence_env": "ci", "compare": "tool", "lanes": ["A1", "B-login"], "probe": ["tool", "ce-tool-env"]},
    {"id": "FL-TOOL-login/direct", "track": "full_local_parity", "mandatory": true, "evidence_env": "ci", "compare": "tool", "lanes": ["A1", "B-direct"], "probe": ["tool", "ce-tool-login"], "note": "tool put on PATH by ~/.zprofile"},
    {"id": "FL-TOOL-login/login", "track": "full_local_parity", "mandatory": true, "evidence_env": "ci", "compare": "tool", "lanes": ["A1", "B-login"], "probe": ["tool", "ce-tool-login"]},
    {"id": "FL-TOOL-rc/direct", "track": "full_local_parity", "mandatory": true, "evidence_env": "ci", "compare": "tool", "lanes": ["A1", "B-direct"], "probe": ["tool", "ce-tool-rc"], "note": "tool put on PATH only by interactive ~/.zshrc (the shape of an nvm-style setup)"},
    {"id": "FL-TOOL-rc/login", "track": "full_local_parity", "mandatory": true, "evidence_env": "ci", "compare": "tool", "lanes": ["A1", "B-login"], "probe": ["tool", "ce-tool-rc"]},
    {"id": "FL-TOOL-shadow/direct", "track": "full_local_parity", "mandatory": true, "evidence_env": "ci", "compare": "tool", "lanes": ["A1", "B-direct"], "probe": ["tool", "ce-tool-shadow"], "note": "same name in a login root (v1) and an interactive root (v2); the terminal resolves v2"},
    {"id": "FL-TOOL-shadow/login", "track": "full_local_parity", "mandatory": true, "evidence_env": "ci", "compare": "tool", "lanes": ["A1", "B-login"], "probe": ["tool", "ce-tool-shadow"]},
    {"id": "FL-TOOL-launcher/direct", "track": "full_local_parity", "mandatory": true, "evidence_env": "ci", "compare": "tool", "lanes": ["A1", "B-direct"], "probe": ["tool", "ce-launcher"], "note": "#!/usr/bin/env ce-interp script; interpreter shadowed like the tool above"},
    {"id": "FL-TOOL-launcher/login", "track": "full_local_parity", "mandatory": true, "evidence_env": "ci", "compare": "tool", "lanes": ["A1", "B-login"], "probe": ["tool", "ce-launcher"]},
    {"id": "FL-TOOL-git/direct", "track": "full_local_parity", "mandatory": false, "evidence_env": "ci", "compare": "tool", "lanes": ["A1", "B-direct"], "probe": ["tool", "git"], "note": "host-dependent observation (not mandatory, so A1 stays repeatable): the runner's fixed PATH puts /opt/homebrew/bin ahead of the session PATH, so the outcome depends on whether the host has a Homebrew git; FL-D-TOOL-git is the mandatory real case"},
    {"id": "FL-TOOL-git/login", "track": "full_local_parity", "mandatory": false, "evidence_env": "ci", "compare": "tool", "lanes": ["A1", "B-login"], "probe": ["tool", "git"], "note": "host-dependent observation, see FL-TOOL-git/direct"},
    {"id": "FL-ENV-ssh-agent/direct", "track": "full_local_parity", "mandatory": true, "evidence_env": "ci", "compare": "capability", "lanes": ["A1", "B-direct"], "probe": ["ssh-agent"], "note": "synthetic agent socket in the tmux server environment; /usr/bin/ssh-add -l reaches it (exit 0/1) or not (exit 2)"},
    {"id": "FL-ENV-ssh-agent/login", "track": "full_local_parity", "mandatory": true, "evidence_env": "ci", "compare": "capability", "lanes": ["A1", "B-login"], "probe": ["ssh-agent"]},
    {"id": "FL-ENV-dev-var/direct", "track": "full_local_parity", "mandatory": true, "evidence_env": "ci", "compare": "capability", "lanes": ["A1", "B-direct"], "probe": ["env", "CE_DEV_VAR"], "note": "a synthetic developer variable of the session environment (the shape of launchctl setenv / DOCKER_HOST-style coordinates)"},
    {"id": "FL-ENV-dev-var/login", "track": "full_local_parity", "mandatory": true, "evidence_env": "ci", "compare": "capability", "lanes": ["A1", "B-login"], "probe": ["env", "CE_DEV_VAR"]},
    {"id": "FL-ENV-coordinates/direct", "track": "full_local_parity", "mandatory": true, "evidence_env": "ci", "compare": "env-coord", "lanes": ["A1", "B-direct"], "probe": ["env-coord", "HOME", "TMPDIR", "USER", "LANG"]},
    {"id": "FL-ENV-shell-var/direct", "track": "full_local_parity", "mandatory": false, "evidence_env": "ci", "compare": "capability", "lanes": ["A1", "B-direct"], "probe": ["env", "SHELL"], "note": "observation only"},
    {"id": "FL-ENV-deck-internal/direct", "track": "full_local_parity", "mandatory": true, "evidence_env": "ci", "compare": "b-absent", "lanes": ["B-direct"], "probe": ["env", "DECK_STATUS_SOCK", "TMUX", "TMUX_PANE"], "note": "Deck-internal coordinates must NOT reach an MCP job (registered transport difference)"},
    {"id": "FL-FS-tmp/direct", "track": "full_local_parity", "mandatory": true, "evidence_env": "ci", "compare": "capability", "lanes": ["A1", "B-direct"], "probe": ["tmp"]},
    {"id": "FL-FS-outside-read/direct", "track": "full_local_parity", "mandatory": true, "evidence_env": "ci", "compare": "capability", "lanes": ["A1", "B-direct"], "probe": ["read", "{outside_file}", "{outside_token}"]},
    {"id": "FL-NET-localhost/direct", "track": "full_local_parity", "mandatory": true, "evidence_env": "ci", "compare": "capability", "lanes": ["A1", "B-direct"], "probe": ["tcp", "{tcp_port}", "{tcp_token}"]},
    {"id": "FL-NET-unix-socket/direct", "track": "full_local_parity", "mandatory": true, "evidence_env": "ci", "compare": "capability", "lanes": ["A1", "B-direct"], "probe": ["unix", "{unix_path}", "{unix_token}"]},
    {"id": "FL-PROC-tree/direct", "track": "full_local_parity", "mandatory": true, "evidence_env": "ci", "compare": "capability", "lanes": ["A1", "B-direct"], "probe": ["tree"]},
    {"id": "FL-GIT-workflow/direct", "track": "full_local_parity", "mandatory": true, "evidence_env": "ci", "compare": "capability", "lanes": ["A1", "B-direct"], "probe": ["git"]},
    {"id": "FL-SHELL-compose/login", "track": "full_local_parity", "mandatory": true, "evidence_env": "ci", "compare": "capability", "lanes": ["A1", "B-login"], "probe": ["compose"]},
    {"id": "FL-CWD-outside-project", "track": "full_local_parity", "mandatory": true, "evidence_env": "ci", "compare": "capability", "lanes": ["A1", "B-admission"], "probe": ["cwd", "{outside_dir}"], "a_cwd": "{outside_dir}", "note": "the terminal can work in any existing directory; B is the production deck_exec admission of that cwd"},
    {"id": "FL-D-TOOL-node", "track": "full_local_parity", "mandatory": true, "evidence_env": "designated", "compare": "tool", "lanes": ["A2", "B-designated"], "probe": ["tool", "node"]},
    {"id": "FL-D-TOOL-npm", "track": "full_local_parity", "mandatory": true, "evidence_env": "designated", "compare": "tool", "lanes": ["A2", "B-designated"], "probe": ["tool", "npm"]},
    {"id": "FL-D-TOOL-cargo", "track": "full_local_parity", "mandatory": true, "evidence_env": "designated", "compare": "tool", "lanes": ["A2", "B-designated"], "probe": ["tool", "cargo"]},
    {"id": "FL-D-TOOL-rustc", "track": "full_local_parity", "mandatory": true, "evidence_env": "designated", "compare": "tool", "lanes": ["A2", "B-designated"], "probe": ["tool", "rustc"]},
    {"id": "FL-D-TOOL-python3", "track": "full_local_parity", "mandatory": true, "evidence_env": "designated", "compare": "tool", "lanes": ["A2", "B-designated"], "probe": ["tool", "python3"]},
    {"id": "FL-D-TOOL-git", "track": "full_local_parity", "mandatory": true, "evidence_env": "designated", "compare": "tool", "lanes": ["A2", "B-designated"], "probe": ["tool", "git"]},
    {"id": "FL-D-ENV-ssh-agent", "track": "full_local_parity", "mandatory": true, "evidence_env": "designated", "compare": "capability", "lanes": ["A2", "B-designated"], "probe": ["ssh-agent"]},
    {"id": "FL-D-NET-internet", "track": "full_local_parity", "mandatory": true, "evidence_env": "designated", "compare": "capability", "lanes": ["A2", "B-designated"], "probe": ["https-head", "{designated_https_url}"]},
    {"id": "FL-D-DOCKER-cli", "track": "full_local_parity", "mandatory": false, "evidence_env": "designated", "compare": "capability", "lanes": ["A2", "B-designated"], "probe": ["docker-version"], "note": "extension: only meaningful where the terminal has Docker"}
  ]
}
