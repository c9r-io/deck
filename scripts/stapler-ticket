#!/usr/bin/env python3
"""Attach or validate Apple's ticket, retrying only the observed CloudKit disconnect.

Release tooling only: six attempts, each bounded to 60 seconds, with
5/10/20/40/80 second waits (about two and a half minutes of waiting in all:
Apple's ticket endpoint has dropped connections for minutes at a time, 2026-10-15
and 2026-10-19). Success requires stapler's exit 0. Only exit 68 together with
NSURLErrorDomain -1005 at Apple's ticket endpoint is retryable; invalid tickets,
other errors and timeouts fail closed. Every completed attempt's output is retained.
"""

import argparse
from pathlib import Path
import subprocess
import sys
import time

ATTEMPTS = 6
FIRST_DELAY = 5


def ticket(operation: str, path: str) -> int:
    if operation not in ("staple", "validate"):
        raise ValueError("only staple and validate are permitted")
    command = ["/usr/bin/xcrun", "stapler", operation, str(Path(path).resolve())]
    for attempt in range(ATTEMPTS):
        try:
            result = subprocess.run(command, capture_output=True, text=True,
                                    encoding="utf-8", errors="replace", timeout=60)
        except subprocess.TimeoutExpired:
            print(f"stapler {operation} timed out; refusing publication", file=sys.stderr)
            return 124
        print(result.stdout, end="")
        print(result.stderr, end="", file=sys.stderr)
        output = result.stdout + result.stderr
        retryable = (
            result.returncode == 68
            and "NSURLErrorDomain Code=-1005 " in output
            and "https://api.apple-cloudkit.com/database/1/com.apple.gk.ticket-delivery/production/public/records/lookup" in output
        )
        if not retryable or attempt == ATTEMPTS - 1:
            return result.returncode if result.returncode >= 0 else 1
        delay = FIRST_DELAY * 2 ** attempt
        print(f"Apple ticket connection lost; retrying {operation} in {delay}s "
              f"(attempt {attempt + 2}/{ATTEMPTS})", file=sys.stderr, flush=True)
        time.sleep(delay)
    raise AssertionError("unreachable")


if __name__ == "__main__":
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("operation", choices=("staple", "validate"))
    parser.add_argument("path")
    args = parser.parse_args()
    raise SystemExit(ticket(args.operation, args.path))
