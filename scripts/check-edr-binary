#!/usr/bin/env bash
# Auxiliary vocabulary scan only: `strings` cannot find short literals of
# eight bytes or fewer when the compiler encodes them as immediates (for
# example /bin/zsh or /bin/sh). tests/edr_quiet.rs (deck.app) and the census
# in tools/deck-tunnelctl/src/lib.rs (the optional helper) are authoritative.
#
# Usage: scripts/check-edr-binary /path/to/deck.app
#        scripts/check-edr-binary /path/to/deck-tunnelctl   (one executable)
set -euo pipefail

target_path=${1:?usage: scripts/check-edr-binary /path/to/deck.app | /path/to/executable}
if [ -f "$target_path" ]; then
  targets=("$target_path")
else
  info="$target_path/Contents/Info.plist"
  test -f "$info"
  executable=$(/usr/libexec/PlistBuddy -c 'Print :CFBundleExecutable' "$info")
  macos="$target_path/Contents/MacOS"
  targets=("$macos/$executable" "$macos/deck-status-helper")
  # deck-lifecycle-helper is a sidecar that older bundles never had, and an
  # immutable candidate built before it existed is still re-checked here at
  # promotion, so it can never become unconditionally required. Whether THIS
  # bundle must carry it is read from the bundle itself, with no network and
  # no version table: the application executable is searched for the helper's
  # file name. Two things put that name there, and either one is enough:
  #   - today's literals in agent_status.rs: LIFECYCLE_HELPER_NAME, joined
  #     onto the executable's directory at run time, and
  #     LIFECYCLE_HELPER_MARKER, compared against hook commands. Both are
  #     string DATA read by live code, not symbols: `strip` removes symbol
  #     and debug tables only, and LTO may drop a constant only together with
  #     every use of it, that is, only from an application that no longer
  #     uses the helper. Measured on a local release build (lto, strip);
  #   - a dedicated marker, `deck-bundle-requires:deck-lifecycle-helper`,
  #     a `#[used]` static. `#[used]` keeps it in the object file; whether
  #     the final link keeps it is not promised by the language, only
  #     observed in a local release build. It ends in the same name, so the
  #     one search below finds it when it is there, and the rule does not
  #     rest on it: the literals above are enough.
  # The name is 21 bytes, far past the eight `strings` may miss. Therefore:
  #   - helper file present         -> always scanned like every other sidecar,
  #                                    whatever the application says;
  #   - absent, name in the app     -> the bundle is incomplete: rejected;
  #   - absent, name not in the app -> a bundle from before the helper: accepted.
  # An application executable that is empty or cannot be read as strings
  # decides nothing and is rejected rather than taken for an old bundle. The
  # one-executable form above never applies this rule: a bare file has no
  # bundle to be incomplete.
  lifecycle="$macos/deck-lifecycle-helper"
  test -f "$macos/$executable"
  if [ ! -s "$macos/$executable" ]; then
    echo "$macos/$executable is empty and cannot decide whether deck-lifecycle-helper is required" >&2
    exit 1
  fi
  set +e
  strings -a "$macos/$executable" | LC_ALL=C grep -F -c -- deck-lifecycle-helper >/dev/null
  evidence=("${PIPESTATUS[@]}")
  set -e
  # strings must succeed; grep answers 0 (named), 1 (not named) or an error.
  if [ "${evidence[0]}" -ne 0 ] || [ "${evidence[1]}" -gt 1 ]; then
    echo "$macos/$executable could not be read to decide whether deck-lifecycle-helper is required" >&2
    exit 1
  fi
  if [ -e "$lifecycle" ] || [ -L "$lifecycle" ]; then
    # Present in any form: it joins the scanned files, where anything but a
    # regular file fails below. An old-looking application does not excuse it.
    targets+=("$lifecycle")
  elif [ "${evidence[1]}" -eq 0 ]; then
    echo "$macos/$executable references deck-lifecycle-helper, but the bundle does not contain it" >&2
    exit 1
  fi
  targets+=("$macos/deck-mcp" "$macos/deck-mcp-runner")
fi
for target in "${targets[@]}"; do
  test -f "$target"
  for forbidden in \
    launchctl LaunchAgents LaunchDaemons SMAppService osascript \
    /bin/sh /bin/bash /bin/zsh --deck-shell-bootstrap
  do
    if strings -a "$target" | grep -F -- "$forbidden" >/dev/null; then
      echo "$target contains forbidden EDR token: $forbidden" >&2
      exit 1
    fi
  done
  # Linked by tauri-plugin-updater's macOS installer (an admin AppleScript
  # through OSAKit, and a PATH `touch`). deck never calls that installer:
  # updater.rs downloads/verifies through the plugin and swaps the bundle
  # itself behind a writability guard; tests/edr_quiet.rs pins both the
  # guard and the reviewed plugin version. Their presence is reported, not
  # failed, so a build that drops them is noticed too.
  for gated in "administrator privileges" OSAKit; do
    if strings -a "$target" | grep -F -- "$gated" >/dev/null; then
      echo "$target links gated token (unreachable, see tests/edr_quiet.rs): $gated"
    fi
  done
done
echo "EDR binary vocabulary clean: ${targets[*]}"
