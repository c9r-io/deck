#!/usr/bin/env bash
set -euo pipefail

root=$(cd "$(dirname "$0")/.." && pwd)
# Gate semantics first (offline): no soft-failed gate, and every app build
# depends on a job that runs the RustSec audit.
python3 "$root/scripts/release_channels.py" assert-workflow-gates "$root"/.github/workflows/*.yml

version=1.7.12
archive=actionlint_1.7.12_darwin_arm64.tar.gz
expected=aba9ced2dee8d27fecca3dc7feb1a7f9a52caefa1eb46f3271ea66b6e0e6953f
tool_dir=$(mktemp -d /tmp/deck-actionlint.XXXXXX)
curl --fail --silent --show-error --location \
  "https://github.com/rhysd/actionlint/releases/download/v${version}/${archive}" \
  --output "$tool_dir/$archive"
actual=$(shasum -a 256 "$tool_dir/$archive" | awk '{print $1}')
if [ "$actual" != "$expected" ]; then
  echo "actionlint archive checksum mismatch" >&2
  exit 1
fi
tar -xzf "$tool_dir/$archive" -C "$tool_dir"
"$tool_dir/actionlint" "$@"
