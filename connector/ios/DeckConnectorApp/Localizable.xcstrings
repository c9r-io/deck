    },
    "taskDetail.replies.omitted": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The middle of this reply was not sent to the iPhone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这条回复的中间部分没有传到手机。"
          }
        }
      }
    },
    "taskDetail.replies.offTitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Replies are off on the Mac"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 上还没打开回复"
          }
        }
      }
    },
    "taskDetail.replies.offBody": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On the Mac, turn on “Claude Code replies on the phone” in Settings › Phone Connector. Claude Code that is already running may need a restart before replies arrive."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Mac 的 设置 › Phone Connector 里打开「在手机上显示 Claude Code 的回复」。已经在运行的 Claude Code 可能要重新启动后才会提供回复。"
          }
        }
      }
    },
    "taskDetail.replies.emptyTitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No replies yet"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有回复"
          }
        }
      }
    },
    "taskDetail.replies.emptyBody": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When Claude Code ends a turn, its last message appears here. If Claude Code was already running when replies were turned on, it may need a restart first."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code 每结束一轮，它的最后一条回复会出现在这里。如果打开开关时 Claude Code 已经在运行，可能要先重新启动它。"
          }
        }
      }
    },
    "taskDetail.replies.unavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Replies could not be read. Pull down to try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "读不到回复，下拉重试。"
          }
        }
      }
    },
    "taskDetail.replies.newBelow": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New reply"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有新回复"
          }
        }
      }
    },
    "taskDetail.replies.latest": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Latest reply"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "跳到最新"
          }
        }
      }
    },
    "taskDetail.replies.bounds": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Mac keeps the last 20 replies of each card in memory. Restarting Deck clears them."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 在内存里为每张卡片保留最近 20 条回复，Deck 重启后清空。"
          }
        }
      }
    },
    "taskDetail.replies.newest": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Latest reply"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最新回复"
          }
