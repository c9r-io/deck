{
  "sourceLanguage": "en",
  "strings": {
    "taskDetail.output.sessionUnavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is no readable session for this card right now."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此卡片目前没有可读取的会话。"
          }
        }
      }
    },
    "taskDetail.output.agentNotInForeground": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A supported agent is not in the foreground, so its output cannot be read."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "前台没有受支持的智能体，无法读取智能体输出。"
          }
        }
      }
    },
    "taskDetail.output.readFailed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deck could not read the agent output. Refresh to try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Deck 无法读取智能体输出。请刷新后重试。"
          }
        }
      }
    },
    "taskDetail.output.targetChanged": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The target changed while output was being read. Refresh to try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "读取输出时目标发生变化。请刷新后重试。"
          }
        }
      }
    },
    "taskDetail.output.unknown": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deck could not read this output. Refresh to try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Deck 无法读取此输出。请刷新后重试。"
          }
        }
      }
    },
    "taskDetail.keyboard.done": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Done"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完成"
          }
        }
      }
    },
    "taskDetail.output.latest": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Jump to end"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "跳到末尾"
          }
        }
      }
    },
    "taskDetail.message.localDraft": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This draft is saved only on this iPhone. It is not a desktop scratchpad note."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此草稿仅保存在这台 iPhone 上，并不是桌面端的暂存区便签。"
          }
        }
      }
    },
    "taskDetail.message.saveFailed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Draft is kept on this iPhone but is not saved yet: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "草稿仍保留在这台 iPhone 上，但尚未保存：%@"
          }
        }
      }
    },
    "taskDetail.message.saved": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Draft saved on this iPhone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "草稿已保存在这台 iPhone 上。"
          }
        }
      }
    },
    "taskDetail.message.saving": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saving draft on this iPhone…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在将草稿保存到这台 iPhone…"
          }
        }
      }
    },
    "taskDetail.message.send": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发送"
          }
        }
      }
    },
    "taskDetail.message.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send to agent"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发送给智能体"
          }
        }
      }
    },
    "taskDetail.message.unavailable.agent": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This task has no writable Codex or Claude target."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此任务没有可写入的 Codex 或 Claude 目标。"
          }
        }
      }
    },
    "taskDetail.message.unavailable.stopped": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This task is stopped. Start it on the desktop before sending."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此任务已停止。请先在桌面端启动，再发送消息。"
          }
        }
      }
    },
    "taskDetail.message.unavailable.unknown": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deck cannot verify a writable agent target for this task."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Deck 无法确认此任务存在可写入的智能体目标。"
          }
        }
      }
    },
    "taskDetail.note.explanation": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save a note to this card’s desktop scratchpad. Saving does not send it to the agent."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将便签保存到此卡片的桌面端暂存区。保存不会发送给智能体。"
          }
        }
      }
    },
    "taskDetail.note.failed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Note was not saved: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "便签未保存：%@"
          }
        }
      }
    },
    "taskDetail.note.delete": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除"
          }
        }
      }
    },
    "taskDetail.note.external": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "External event"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "外部事件"
          }
        }
      }
    },
    "taskDetail.note.manual": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Manual note"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手工便签"
          }
        }
      }
    },
    "taskDetail.note.pending": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for Deck to confirm the original save…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在等待 Deck 确认原始保存操作…"
          }
        }
      }
    },
    "taskDetail.note.placeholder": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New scratchpad note"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新建暂存区便签"
          }
        }
      }
    },
    "taskDetail.note.rejected": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deck rejected the save."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Deck 拒绝了保存操作。"
          }
        }
      }
    },
    "taskDetail.note.save": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save note"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存便签"
          }
        }
      }
    },
    "taskDetail.note.saved": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved to the desktop scratchpad."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已保存到桌面端暂存区。"
          }
        }
      }
    },
    "taskDetail.note.savedNewer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved the submitted note. Your newer text remains in the editor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已保存提交时的便签；之后输入的新内容仍保留在编辑框中。"
          }
        }
      }
    },
    "taskDetail.note.saving": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saving note…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在保存便签…"
          }
        }
      }
    },
    "taskDetail.queue.copy": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Queued copy: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "排队副本：%@"
          }
        }
      }
    },
    "taskDetail.queue.explanation": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Queueing creates a copy; notes remain in the scratchpad and later edits do not alter that copy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "排队会创建副本；便签仍保留在暂存区，之后的编辑不会改变该副本。"
          }
        }
      }
    },
    "taskDetail.queue.selected": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Queue selected (%lld)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "排队所选项（%lld）"
          }
        }
      }
    },
    "taskDetail.queue.unavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Queueing requires a Codex or Claude launch configuration saved on the desktop."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "排队需要桌面端已保存 Codex 或 Claude 启动配置。"
          }
        }
      }
    },
    "taskDetail.scratchpad.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scratchpad"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂存区"
          }
        }
      }
    },
    "Loading…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loading…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在载入…"
          }
        }
      }
    },
    "Device revoked": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Device revoked"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备已撤销"
          }
        }
      }
    },
    "Remove pairing": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove pairing"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移除配对"
          }
        }
      }
    },
    "OK": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OK"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "好"
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消"
          }
        }
      }
    },
    "Remove this pairing from this phone?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove this pairing from this phone?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从此手机移除配对？"
          }
        }
      }
    },
    "The local recovery archive and unresolved operation history remain on this device.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The local recovery archive and unresolved operation history remain on this device."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本机仍会保留恢复记录和未确认的操作历史。"
          }
        }
      }
    },
    "Revoke status comes from the desktop host. Remove this pairing, then create a new QR code on Deck.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Revoke status comes from the desktop host. Remove this pairing, then create a new QR code on Deck."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 已撤销此设备。请移除配对，然后在 Deck 中生成新的二维码。"
          }
        }
      }
    },
    "Pair with Deck": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pair with Deck"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "与 Deck 配对"
          }
        }
      }
    },
    "On the desktop, enable Connector and create a short-lived pairing code. The phone connects only to that pinned HTTPS host.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On the desktop, enable Connector and create a short-lived pairing code. The phone connects only to that pinned HTTPS host."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Mac 上启用 Phone Connector 并生成配对码，然后扫码连接。"
          }
        }
      }
    },
    "Scan QR code": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan QR code"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扫描二维码"
          }
        }
      }
    },
    "Paste deck-connector:// pairing code": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paste deck-connector:// pairing code"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "粘贴 deck-connector:// 配对码"
          }
        }
      }
    },
    "Pair": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pair"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配对"
          }
        }
      }
    },
    "Scan Deck QR": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan Deck QR"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扫描 Deck 二维码"
          }
        }
      }
    },
    "Pairing data is used once and is not stored. The host identity, certificate pin, device ID and token are stored together in Keychain.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pairing data is used once and is not stored. The host identity, certificate pin, device ID and token are stored together in Keychain."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配对码仅使用一次。连接凭据安全保存在钥匙串中。"
          }
        }
      }
    },
    "Tasks": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tasks"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "卡片"
          }
        }
      }
    },
    "Queue": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Queue"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "队列"
          }
        }
      }
    },
    "New": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新建"
          }
        }
      }
    },
    "Retry task creation": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Retry task creation"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重试创建卡片"
          }
        }
      }
    },
    "Check task creation": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check task creation"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认创建结果"
          }
        }
      }
    },
    "No snapshot": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No snapshot"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未取得看板"
          }
        }
      }
    },
    "Deck must be awake, running, and reachable on the local network or your VPN.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deck must be awake, running, and reachable on the local network or your VPN."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请确保 Mac 已唤醒、Deck 正在运行，且可通过局域网或 VPN 连接。"
          }
        }
      }
    },
    "Refresh": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Refresh"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "刷新"
          }
        }
      }
    },
    "Connecting to desktop…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecting to desktop…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在连接 Mac…"
          }
        }
      }
    },
    "Resume": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Resume"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "继续"
          }
        }
      }
    },
    "Pause": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pause"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂停"
          }
        }
      }
    },
    "Last synced": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Last synced"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最近同步"
          }
        }
      }
    },
    "All card output and notes are shared by this Mac. Messages still require a current Codex or Claude foreground; shell input is unavailable, and queued delivery requires a saved launch configuration.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All card output and notes are shared by this Mac. Messages still require a current Codex or Claude foreground; shell input is unavailable, and queued delivery requires a saved launch configuration."
          }
        },
        "zh-Hans": {
          "stringUnit": {
