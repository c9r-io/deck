    "sharing.setup.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Next time you are at “%@”, choose “Trust this device…” for this phone in Deck → Settings → Remote access to read every card’s output and send messages. Once is enough; no re-pairing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下次回到「%@」时，在 Deck「设置 → 远程访问」中对这台手机选择「信任此设备」，即可查看所有卡片的输出并发送消息。只需一次，无需重新配对。"
          }
