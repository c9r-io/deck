      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Older output was not sent to this iPhone. Only the most recent part is shown."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更早的输出没有传到这台 iPhone，这里只显示最近的一段。"
          }
        }
      }
    },
    "taskDetail.output.newBelow": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New output"
          }
        },
